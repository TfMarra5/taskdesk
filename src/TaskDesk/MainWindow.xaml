<Window x:Class="TaskDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskDesk"
        mc:Ignorable="d"
        Title="TaskDesk"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock
                Text="TaskDesk"
                FontSize="32"
                FontWeight="Bold" />

            <TextBlock
                Text="Your tasks, in one place."
                FontSize="14"
                Foreground="Gray"
                Margin="0,8,0,0" />

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="TaskInput"
                    Grid.Column="0"
                    FontSize="16"
                    Padding="10"
                    VerticalContentAlignment="Center" />

                <Button
                    Grid.Column="1"
                    Content="Add task"
                    Margin="12,0,0,0"
                    Padding="20,10"
                    Click="AddTask_Click" />

            </Grid>
            <ListBox
                x:Name="TaskList"
                Margin="0,20,0,0"
                Height="300"
                FontSize="16" />
        </StackPanel>
    </Grid>
</Window>
